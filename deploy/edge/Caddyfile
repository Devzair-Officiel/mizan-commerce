# Routage public de Mizan (deploy/edge/compose.yml). Les {$VAR} viennent de
# deploy/env/edge.env, lues au démarrage de Caddy.
#
# Seul le frontend Next.js est exposé : le navigateur n'appelle jamais Django
# directement (les appels authentifiés passent par /app/api/*, côté serveur).
# De Django, seules les routes /healthz et /webhooks/stripe/ (appelée par
# Stripe, authentifiée par sa signature) sont routées. L'admin Django n'est
# jamais exposé : accès par tunnel SSH (docs/exploitation/deploiement.md).
{
	email {$ACME_EMAIL}
	# Vide en production. Tests locaux : « local_certs » (autorité interne de Caddy).
	{$CADDY_GLOBAL_OPTIONS}
}

# En-têtes de sécurité. Next.js pose déjà sa CSP (frame-ancestors 'self' sur la
# page publique /boutique, intégrable) : « ? » ne pose l'en-tête que s'il manque.
(security_headers) {
	header {
		defer
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		?Referrer-Policy strict-origin-when-cross-origin
		?Content-Security-Policy "frame-ancestors 'none'"
		?X-Frame-Options DENY
		-Server
		-X-Powered-By
	}
}

# Un environnement : {args[0]} = production ou staging. Les noms d'hôte sont les
# alias des conteneurs sur le réseau edge (deploy/app/compose.yml).
(app) {
	encode zstd gzip
	# Taille maximale d'un corps de requête, contrôlée ici avant tout transfert
	# (413 au-delà). Le scan d'emballage envoie deux photos de 8 Mo au plus
	# (MAX_BODY_BYTES de app/api/ocr/product-scan/route.ts : 16 Mio + 64 Kio) ;
	# ailleurs, le plus grand fichier est une facture de 10 Mo
	# (OCR_DOCUMENT_MAX_SIZE_MB). Marge pour l'enveloppe multipart : les
	# plafonds de Next.js et de Django restent la règle, celui-ci borne ce
	# qu'un client peut faire lire au frontend.
	@product_scan path /api/ocr/product-scan
	@not_product_scan not path /api/ocr/product-scan
	request_body @product_scan {
		max_size 17MiB
	}
	request_body @not_product_scan {
		max_size 11MiB
	}
	handle /healthz {
		reverse_proxy mizan-{args[0]}-backend:8000
	}
	handle /webhooks/stripe/ {
		reverse_proxy mizan-{args[0]}-backend:8000
	}
	handle {
		reverse_proxy mizan-{args[0]}-frontend:3000
	}
}

# Sites servis par ce serveur (deploy/env/edge.env) : « * » pour les deux,
# « production » ou « staging » si staging tourne sur un autre serveur.
import sites/{$EDGE_SITES:*}.caddy
