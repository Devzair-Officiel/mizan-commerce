# Modèle des variables de PRODUCTION. Sur le serveur :
#   cp deploy/env/production.env.example deploy/env/production.env
#   chmod 600 deploy/env/production.env    # puis remplir
# Le fichier rempli n'est jamais commité (.gitignore : deploy/env/*.env).
# Lu par deploy/app/compose.yml, qui transmet à chaque service ses seules variables.
#
# Secrets à générer :  python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
# REDIS_PASSWORD (hex, va dans une URL) : openssl rand -hex 32
# Une valeur qui contient « $ » s'écrit entre apostrophes : VAR='va$leur'.

# ── Environnement ─────────────────────────────────────────────────────────────
# Nom de l'environnement : production ou staging. Doit correspondre au nom du
# fichier ; sert aux alias réseau (Caddyfile) et à l'environnement Sentry.
APP_ENV=production

# ── Django ────────────────────────────────────────────────────────────────────
# Clé de signature Django (sessions, jetons) : 50 caractères au moins, propre à
# cet environnement. La changer déconnecte tous les utilisateurs.
SECRET_KEY=
# Domaines publics servis par Django, séparés par des virgules, plus l'hôte
# Tailscale de l'admin (nom MagicDNS du serveur, sans port ; exemple fictif :
# vps-xxxx.tailnet-exemple.ts.net). S'y ajoutent mizan-production-backend
# (deploy/app/compose.yml : appels du frontend sur le réseau edge) et
# « localhost » (production.py).
DJANGO_ALLOWED_HOSTS=mizan-commerce.com,vps-xxxx.tailnet-exemple.ts.net
# Origines acceptées pour les requêtes avec jeton CSRF (schéma https compris),
# plus l'origine de l'admin par Tailscale Serve, port HTTPS compris (8443 pour
# production).
CSRF_TRUSTED_ORIGINS=https://mizan-commerce.com,https://vps-xxxx.tailnet-exemple.ts.net:8443
# Origines autorisées en CORS. Le navigateur passe par le proxy Next.js, mais la
# liste reste obligatoire et limitée au domaine public.
CORS_ALLOWED_ORIGINS=https://mizan-commerce.com
# URL publique du frontend, utilisée dans les liens des e-mails.
FRONTEND_URL=https://mizan-commerce.com
# Niveau des logs JSON (DEBUG, INFO, WARNING, ERROR).
DJANGO_LOG_LEVEL=INFO
# Port de l'admin Django sur la boucle locale du serveur (127.0.0.1), relayé par
# Tailscale Serve : 8001 en production, 8002 en staging (un port par
# environnement, sinon le second ne démarre pas).
ADMIN_LOCAL_PORT=8001
# Processus gunicorn : 2 × cœurs + 1 au plus, borné par BACKEND_MEM_LIMIT (≈ 150 Mo chacun).
GUNICORN_WORKERS=3
# Processus du worker Celery « default » (e-mails, rappels, tâches planifiées).
CELERY_DEFAULT_CONCURRENCY=2

# ── PostgreSQL (conteneur postgres) ───────────────────────────────────────────
# Nom de la base créée au premier démarrage.
POSTGRES_DB=mizan
# Super-utilisateur créé au premier démarrage : conteneur postgres, sauvegardes
# et maintenance seulement, jamais l'application.
POSTGRES_USER=mizan
# Mot de passe de ce super-utilisateur. Fixé au premier démarrage du volume : le
# changer ensuite demande un ALTER USER dans la base.
POSTGRES_PASSWORD=
# Rôle de l'application (Django, Celery), sans privilège d'administration,
# propriétaire de la base : créé ou mis à jour à chaque déploiement
# (docs/exploitation/deploiement.md, « Comptes PostgreSQL »).
APP_DB_USER=mizan_app
# Mot de passe de ce rôle, différent de POSTGRES_PASSWORD : openssl rand -hex 32
# Le changer ici suffit : appliqué au déploiement suivant.
APP_DB_PASSWORD=

# ── Redis (broker Celery) ─────────────────────────────────────────────────────
# Mot de passe Redis, en hexadécimal (il entre dans l'URL redis://).
REDIS_PASSWORD=
# Mémoire maximale de Redis, sous REDIS_MEM_LIMIT ; au-delà, Redis refuse les
# écritures au lieu de perdre des tâches.
REDIS_MAXMEMORY=192mb

# ── E-mail (SMTP) ─────────────────────────────────────────────────────────────
# Serveur SMTP d'envoi.
EMAIL_HOST=
# Port SMTP (STARTTLS).
EMAIL_PORT=587
# Identifiant SMTP.
EMAIL_HOST_USER=
# Mot de passe ou clé API SMTP.
EMAIL_HOST_PASSWORD=
# Expéditeur des e-mails.
DEFAULT_FROM_EMAIL=noreply@mizan-commerce.com

# ── reCAPTCHA v3 (inscription, connexion) ─────────────────────────────────────
# Clé secrète serveur. La clé de site publique est fixée à la construction de
# l'image frontend (variable du dépôt NEXT_PUBLIC_RECAPTCHA_SITE_KEY, docs/ci.md).
RECAPTCHA_SECRET_KEY=
# Score minimal accepté, de 0 à 1.
RECAPTCHA_MIN_SCORE=0.5

# ── Stockage OVH Object Storage (S3) ──────────────────────────────────────────
# Clé d'accès S3 d'un utilisateur limité au bucket de production.
OVH_S3_ACCESS_KEY=
# Clé secrète S3 correspondante.
OVH_S3_SECRET_KEY=
# Point d'accès S3 de la région.
OVH_S3_ENDPOINT_URL=https://s3.gra.io.cloud.ovh.net
# Région OVH du bucket.
OVH_S3_REGION=gra
# Bucket privé de PRODUCTION, distinct de celui de staging et du développement.
OVH_S3_BUCKET_PRIVATE=mizan-production-private

# ── Sauvegardes PostgreSQL (WAL-G, docs/exploitation/sauvegardes.md) ─────────
# Bucket S3 de sauvegardes, dans une AUTRE région que le serveur (un incident
# régional ne doit pas emporter la base et ses copies). Les sauvegardes vont
# sous le préfixe APP_ENV (production/) : un même bucket pour les deux environnements.
BACKUP_S3_ENDPOINT_URL=https://s3.sbg.io.cloud.ovh.net
# Région du bucket de sauvegardes.
BACKUP_S3_REGION=sbg
# Nom du bucket de sauvegardes (privé).
BACKUP_S3_BUCKET=mizan-backups
# Clé d'accès S3 d'un utilisateur limité au préfixe production/ de ce bucket.
BACKUP_S3_ACCESS_KEY=
# Clé secrète S3 correspondante.
BACKUP_S3_SECRET_KEY=
# Clé de chiffrement des sauvegardes (libsodium), propre à production :
#   openssl rand -hex 32
# À COPIER AUSSI dans le gestionnaire de mots de passe, hors du serveur : sans
# elle, les sauvegardes sont illisibles. La changer rend les anciennes illisibles.
BACKUP_ENCRYPTION_KEY=
# Heure (UTC) de la sauvegarde complète quotidienne, HH:MM.
BACKUP_TIME=02:30
# Durée de conservation, en jours : retour possible à tout instant de cette période.
BACKUP_RETENTION_DAYS=30
# URL de surveillance appelée après chaque sauvegarde complète (Healthchecks.io
# ou Better Stack) ; échec : la même URL suivie de /fail. Vide = non surveillé.
BACKUP_HEARTBEAT_URL=
# URL de surveillance du contrôle de l'archivage (toutes les 5 min) ; vide = un
# retard d'archivage est signalé en échec sur BACKUP_HEARTBEAT_URL.
ARCHIVE_HEARTBEAT_URL=
# Retard d'archivage toléré, en minutes, avant le signal d'échec.
ARCHIVE_MAX_DELAY_MINUTES=5
# Jour du mois (1 à 28) et heure (UTC) du test de restauration automatique.
RESTORE_TEST_DAY=1
RESTORE_TEST_TIME=04:00
# URL de surveillance du test de restauration mensuel (succès ou /fail).
RESTORE_TEST_HEARTBEAT_URL=
# Vide en temps normal. Mise en service d'une base restaurée : nom du volume
# créé par deploy/backup/restore.sh (docs/exploitation/sauvegardes.md).
POSTGRES_DATA_VOLUME=

# ── Service IA (OCR, extraction de factures) ──────────────────────────────────
# Clé partagée entre Django/Celery et le service IA (appels internes).
AI_SERVICE_API_KEY=
# Délai des appels courts au service IA, en secondes.
AI_SERVICE_TIMEOUT_SECONDS=5
# Délai d'un appel OCR, en secondes (un PDF scanné de 5 pages : 5 lectures d'image).
AI_SERVICE_OCR_TIMEOUT_SECONDS=180
# Délai d'une extraction de facture, en secondes (supérieur à OPENAI_INVOICE_TIMEOUT_SECONDS).
AI_SERVICE_INVOICE_TIMEOUT_SECONDS=50
# Clé API OpenAI pour l'extraction de factures ; vide = extraction refusée (503).
OPENAI_API_KEY=
# Modèle OpenAI utilisé pour l'extraction.
OPENAI_INVOICE_MODEL=gpt-5-mini
# Délai de l'appel OpenAI, en secondes.
OPENAI_INVOICE_TIMEOUT_SECONDS=45
# Threads CPU de PaddleOCR.
PADDLE_OCR_CPU_THREADS=2

# ── Frontend (exécution) ──────────────────────────────────────────────────────
# Clé MapTiler (cartes), lue par le serveur Next.js.
MAPTILER_API_KEY=

# ── Sentry (backend) ──────────────────────────────────────────────────────────
# DSN du projet Sentry backend ; vide = Sentry désactivé. L'environnement Sentry
# vient de APP_ENV, la release de l'image (identifiant du commit). Le DSN
# frontend est fixé à la construction de l'image (docs/ci.md).
SENTRY_DSN=
# Part des transactions envoyées (performances), de 0 à 1.
SENTRY_TRACES_SAMPLE_RATE=0

# ── Limites mémoire des conteneurs (total ≈ 6,1 Go sur 12) ────────────────────
# PostgreSQL.
POSTGRES_MEM_LIMIT=1g
# Redis (au-dessus de REDIS_MAXMEMORY).
REDIS_MEM_LIMIT=256m
# Backend gunicorn.
BACKEND_MEM_LIMIT=768m
# Worker Celery « default ».
CELERY_DEFAULT_MEM_LIMIT=512m
# Worker Celery « ocr » (appels HTTP au service IA, un à la fois).
CELERY_OCR_MEM_LIMIT=384m
# Celery Beat.
CELERY_BEAT_MEM_LIMIT=192m
# Frontend Next.js.
FRONTEND_MEM_LIMIT=512m
# Service IA : le pipeline PaddleOCR occupe environ 1 Go.
AI_SERVICE_MEM_LIMIT=2g
# Planificateur des sauvegardes (WAL-G, instance temporaire du test de restauration).
BACKUP_MEM_LIMIT=512m


VISION_PROVIDER=none
VISION_MODEL=
VISION_TIMEOUT_SECONDS=30
AI_SERVICE_PRODUCT_SCAN_TIMEOUT_SECONDS=40
PRODUCT_SCAN_VISION_THRESHOLD=0.7

PRODUCT_TEXT_MODEL=
PRODUCT_TEXT_TIMEOUT_SECONDS=15
PRODUCT_SCAN_IMAGE_FALLBACK=false

# ── Stripe (paiement des abonnements) ─────────────────────────────────────────
# Clé API secrète. Production : clé RESTREINTE de production (« rk_live_… »).
# Staging : clé de TEST (« sk_test_… »), aucun vrai paiement ne doit passer par staging.
# Vide = facturation désactivée. Ne jamais la coller dans un chat ni un ticket.
STRIPE_SECRET_KEY=
# Secret de signature du webhook de CET environnement (« whsec_… »), propre à
# l'endpoint créé dans le Dashboard : sans lui, aucun événement n'est accepté.
STRIPE_WEBHOOK_SECRET=
