# Modèle des variables de l'entrée (Caddy, deploy/edge). Sur le serveur :
#   cp deploy/env/edge.env.example deploy/env/edge.env
#   chmod 600 deploy/env/edge.env    # puis remplir
# Le fichier rempli n'est jamais commité (.gitignore : deploy/env/*.env).

# Sites servis par ce serveur : * (production et staging sur la même machine),
# production ou staging (staging sur un serveur séparé).
EDGE_SITES=*
# Adresse de contact Let's Encrypt (expiration ou problème de certificat).
ACME_EMAIL=
# Domaine de production, sans « www. » (www redirige vers lui).
PRODUCTION_DOMAIN=mizan-commerce.com
# Domaine de staging, protégé par authentification HTTP basique.
STAGING_DOMAIN=staging.mizan-commerce.com
# Identifiant de l'authentification basique de staging.
STAGING_BASIC_AUTH_USER=
# Empreinte bcrypt du mot de passe (jamais le mot de passe lui-même), entre
# apostrophes car elle contient des « $ ». Le mot de passe est demandé au clavier
# (rien dans l'historique du shell) :
#   docker run --rm -it caddy:2.11-alpine caddy hash-password
STAGING_BASIC_AUTH_HASH=''
# Options globales de Caddy. Vide en production. Tests locaux seulement :
# « local_certs » (certificats de l'autorité interne de Caddy, pas Let's Encrypt).
CADDY_GLOBAL_OPTIONS=
