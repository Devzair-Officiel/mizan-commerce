# ─── Base de données ──────────────────────────────────────────────────────────
POSTGRES_DB=mizan_db
POSTGRES_USER=mizan_user
POSTGRES_PASSWORD=CHANGE_ME_MOT_DE_PASSE_FORT
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.production

# Générer avec : python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=CHANGE_ME

DEBUG=False

# Listes séparées par virgule (sans espaces)
ALLOWED_HOSTS=mizan-commerce.com,www.mizan-commerce.com
CSRF_TRUSTED_ORIGINS=https://mizan-commerce.com,https://www.mizan-commerce.com
CORS_ALLOWED_ORIGINS=https://mizan-commerce.com,https://www.mizan-commerce.com
FRONTEND_URL=https://mizan-commerce.com

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=noreply@mizan-commerce.com

# ─── OVH Object Storage S3 (optionnel, laisser vide si non utilisé) ───────────
OVH_S3_ACCESS_KEY=
OVH_S3_SECRET_KEY=
OVH_S3_BUCKET_PRIVATE=mizan-private
OVH_S3_ENDPOINT_URL=https://s3.gra.io.cloud.ovh.net
OVH_S3_REGION=gra
