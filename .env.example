# Base de données
POSTGRES_DB=mizan_db
POSTGRES_USER=mizan_user
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Django
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=changeme
DEBUG=True

# Redis
REDIS_URL=redis://redis:6379/0

# Service IA interne (FastAPI). La clé ne doit avoir aucune valeur par défaut
# en prod — le backend refuse tout appel non authentifié. Ne PAS committer .env.
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_SECONDS=5
# Timeouts dédiés — supérieurs aux sondes /health pour absorber le chargement
# à froid de PaddleOCR (OCR ~60 s) et le budget OpenAI côté ai-service (~45 s).
AI_SERVICE_OCR_TIMEOUT_SECONDS=60
AI_SERVICE_INVOICE_TIMEOUT_SECONDS=50

# Clé OpenAI utilisée UNIQUEMENT par ai-service pour la structuration facture.
# Le backend Django n'y accède jamais.
OPENAI_API_KEY=

HOST_UID=1000
HOST_GID=1000

SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

VISION_PROVIDER=none
VISION_MODEL=
VISION_TIMEOUT_SECONDS=30
AI_SERVICE_PRODUCT_SCAN_TIMEOUT_SECONDS=40
PRODUCT_SCAN_VISION_THRESHOLD=0.7